+int comicreader_rar_solid(struct archive *archive)
+{
+  struct archive_read *a = (struct archive_read *)archive;
+  struct rar *rar;
+  if (archive == NULL || archive_format(archive) != ARCHIVE_FORMAT_RAR ||
+      a->format == NULL || a->format->data == NULL)
+    return 0;
+  rar = a->format->data;
+  return (rar->main_flags & MHD_SOLID) != 0 ||
+      (rar->file_flags & FHD_SOLID) != 0;
+}
 
